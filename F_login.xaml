<Window x:Class="SalesManagement_SysDev.F_login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="販売管理システムログイン画面"
        Width="816" Height="489" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Meiryo" FontSize="12">
    <Grid Margin="24,12,32,12">
        <StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="販売在庫管理システム" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,24"/>
          <TextBlock Text="社員ID"/><TextBox x:Name="txtEmployeeId" Height="30" Margin="0,4,0,10"/>
          <TextBlock Text="パスワード"/><PasswordBox x:Name="txtPassword" Height="30" Margin="0,4,0,14"/>
          <Button Content="ログイン" Height="36" Click="Login_Click"/>
          <TextBlock x:Name="lblMessage" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="btn_CleateDabase"
                    Width="130" Height="49" Margin="0,0,0,21"
                    Click="btn_CleateDabase_Click">
                <TextBlock Text="データベース生成" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
            <Button x:Name="btn_InsertSampleData"
                    Width="130" Height="49"
                    Click="btn_InsertSampleData_Click">
                <TextBlock Text="サンプルデータ登録" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
